{"url": "https://www.kwongwah.com.my/20250116/%E9%9B%AA%E9%9A%86%E5%98%89%E5%BA%94%E4%BC%9A%E9%A6%86%E9%9D%92%E5%B9%B4%E5%9B%A2-%E6%8C%A5%E6%98%A5%E8%B5%9B%E5%90%B8%E5%BC%95%E9%80%BE200%E4%BA%BA/", "meta_date": "", "title": "\u96ea\u9686\u5609\u5e94\u4f1a\u9986\u9752\u5e74\u56e2 \u6325\u6625\u8d5b\u5438\u5f15\u903e200\u4eba\u5149\u534e\u65e5\u62a5 | 1910\u5e74\u521b\u520a \u521b\u65b0\u6bcf\u4e00\u5929\u751f\u6d3b", "text": "\u96ea\u9686\u5609\u5e94\u4f1a\u9986\u9752\u5e74\u56e2 \u6325\u6625\u8d5b\u5438\u5f15\u903e200\u4eba\u5149\u534e\u65e5\u62a5 | 1910\u5e74\u521b\u520a \u521b\u65b0\u6bcf\u4e00\u5929\u751f\u6d3b\n\u96ea\u9686\u5609\u5e94\u9752\u5e74\u56e2\u53ca\u8463\u4e8b\u4eec\u4e0e\u5f97\u5956\u8005\u5408\u5f71\u3002\u524d\u6392\u5de6\u8d77\u4e3a\u6881\u7acb\u5349\u3001\u53f6\u6cbb\u5fe0\u3001\u5218\u5f69\u7965\u3001\u5085\u5927\u660c\u3001\u5468\u5c55\u5176\u3001\u6881\u79cb\u5e73\u3001\u953a\u58f0\u680b\u3001\u6881\u96ea\u840d\u3001\u4faf\u4e3d\u840d\u3001\u6881\u56fd\u8d22\u3001\u9ec4\u632f\u660c\u3001\u5f20\u4e16\u806a\u3001\u9648\u65b0\u6743\u3001\u9ec4\u6000\u7231\u3001\u66fe\u5e86\u798f\u3001\u53f6\u89c2\u5fe0\u3001\u5218\u56fd\u5149\u3001\u5f90\u667a\u6e2d\u3002\n\u96ea\u9686\u5609\u5e94\u4f1a\u9986\u9752\u5e74\u56e2\u65e5\u524d\u5728\u5409\u9686\u5761\u9646\u4f51\u8def\u4e2d\u56fd\u5b66\u6821\u4e3e\u529e\u20362025\u4e59\u5df3\u5e74\u6325\u6625\u8d5b\u2033, \u5438\u5f15\u903e200\u4eba\u62a5\u540d\u53c2\u52a0\u3002\n\u8be5\u56e2\u957f\u4faf\u4e3d\u840d\u81f4\u8bcd\u8bf4, \u6325\u6625\u6bd4\u8d5b\u662f\u96ea\u9686\u5609\u5e94\u4f1a\u9986\u9752\u5e74\u56e2\u6bcf\u5e74\u7684\u91cd\u70b9\u6d3b\u52a8\u4e4b\u4e00, \u6bcf\u5e74\u90fd\u5438\u5f15\u96ea\u9686\u5404\u5730\u6570\u767e\u540d\u7684\u5b66\u751f\u53ca\u516c\u4f17\u4eba\u58eb\u62a5\u540d\u53c2\u52a0, \u4f46\u53d7\u573a\u5730\u9650\u5236, \u53ea\u63a5\u53d7320\u4e2a\u540d\u989d, \u56e0\u6b64\u547c\u5401\u4eca\u5e74\u65e0\u6cd5\u53c2\u8d5b\u7684\u62a5\u540d\u8005\u5728\u6765\u5e74\u8d81\u65e9\u62a5\u540d\u3002\n\u53e6\u5916\uff0c\u90a3\u4e9b\u5df2\u62a5\u540d\u800c\u4e0d\u51fa\u5e2d\u53c2\u8d5b\u8005\u5219\u5c06\u4ece\u660e\u5e74\u5f00\u59cb\u5217\u5165\u9ed1\u540d\u5355, \u628a\u540d\u989d\u8ba9\u7ed9\u5176\u4ed6\u6709\u5174\u8da3\u53c2\u8d5b\u7684\u4eba\u3002\n\u201c\u6211\u4e5f\u671f\u671b\u6240\u6709\u53c2\u8d5b\u8005\u53d1\u626c\u53cb\u8c0a\u7b2c\u4e00\u3001\u6bd4\u8d5b\u7b2c\u4e8c\u7cbe\u795e, \u5199\u51fa\u98ce\u683c, \u8d5b\u51fa\u4f18\u5f02\u6210\u7ee9, \u66f4\u671f\u671b\u5168\u4f53\u88c1\u5224\u8001\u5e08\u53d1\u626c\u516c\u6b63\u65e0\u79c1\u7684\u7cbe\u795e, \u628a\u8fd9\u9879\u8d5b\u4f1a\u529e\u597d\u3002\u201d\n\u540c\u65f6, \u4f1a\u957f\u6881\u56fd\u8d22\u5728\u9881\u5956\u793c\u4e0a\u8bf4, \u519c\u5386\u65b0\u5e74\u662f\u4e2d\u534e\u6c11\u65cf\u6700\u91cd\u8981\u7684\u4f20\u7edf\u8282\u65e5, \u4e66\u6cd5\u662f\u62e5\u67095000\u591a\u5e74\u7684\u4e2d\u534e\u6587\u5316\u7470\u5b9d, \u6587\u5316\u5185\u6db5\u4e30\u5bcc, \u5386\u53f2\u4f20\u627f\u60a0\u4e45, \u5728\u65b0\u6625\u4f73\u8282\u5199\u5bf9\u8054\u3001\u6302\u798f\u5b57\u4f53\u73b0\u4e86\u4e2d\u534e\u6587\u5316\u4f20\u7edf, \u4e5f\u51dd\u805a\u5168\u7403\u534e\u4eba\u201c\u4e00\u8d77\u5411\u672a\u6765\u201d\u7684\u4fe1\u5fc3\u4e0e\u529b\u91cf\u3002\n\u201c\u96ea\u9686\u5609\u5e94\u4f1a\u9986\u4e59\u5df3\u5e74\u6325\u6625\u8d5b\u7684\u6210\u529f\u4e3e\u529e\u4e3a\u4e0d\u540c\u65cf\u7fa4\u3001\u4e0d\u540c\u6587\u5316\u4ea4\u6d41\u878d\u5408\u63d0\u4f9b\u4e86\u5f88\u597d\u7684\u673a\u4f1a, \u5927\u5bb6\u5728\u7b14\u58a8\u7eb8\u781a\u4e2d\u884c\u4e91\u6d41\u6c34, \u4e66\u5199\u7684\u662f\u7f8e\u597d\u795d\u798f, \u5c55\u73b0\u7684\u662f\u6587\u5316\u591a\u5143, \u5f18\u626c\u7684\u662f\u5f00\u653e\u5305\u5bb9\u3001\u548c\u8c10\u5171\u5b58, \u751f\u52a8\u53cd\u6620\u5305\u62ec\u4e2d\u56fd\u4eba\u548c\u9a6c\u6765\u897f\u4e9a\u4eba\u6c11\u5728\u5185\u7684\u5404\u56fd\u4eba\u6c11\u52a0\u5f3a\u6587\u660e\u4ea4\u6d41\u4e92\u9274\u7684\u5f3a\u70c8\u613f\u671b, \u96c6\u4e2d\u4f53\u73b0\u8fd9\u4e00\u5168\u7403\u547c\u5401\u7684\u6c38\u6052\u4ef7\u503c\u548c\u957f\u4e45\u751f\u547d\u529b\u3002\u771f\u8bda\u5e0c\u671b\u6325\u6625\u6bd4\u8d5b\u8fd9\u6837\u7684\u6d3b\u52a8\u7ee7\u7eed\u4e3e\u529e\u4e0b\u53bb, \u8d8a\u529e\u8d8a\u706b\u7ea2, \u4e3a\u9a6c\u4e2d\u4e24\u56fd\u4eba\u6c11\u52a0\u5f3a\u4ea4\u6d41\u63d0\u4f9b\u5e7f\u9614\u5e73\u53f0\u3002\u201d\n\u51fa\u5e2d\u8005\u6709\u9ec4\u632f\u660c\u3001\u6881\u96ea\u840d\u3001\u9ec4\u6000\u7231\u3001\u9648\u65b0\u6743\u3001\u6881\u7acb\u5349\u3001\u6881\u79cb\u5e73\u3001\u5218\u56fd\u5149\u3001\u953a\u58f0\u680b\u3001\u5f20\u4e16\u806a\u3001\u5218\u5f69\u7965\u3001\u5085\u5927\u660c\u3001\u5f90\u667a\u6e2d\u3001\u53f6\u89c2\u5fe0\u3001\u53f6\u6cbb\u5fe0\u3001\u66fe\u5e86\u798f\u3001\u5218\u7d2b\u826f\u548c\u5468\u5c55\u5176\u7b49\u3002\nA. \u516c\u5f00\u8d5b \u51a0\u519b\uff1a\u5f6d\u7d20\u4eea \u4e9a\u519b\uff1a\u675c\u827a\u5a1c \u5b63\u519b\uff1a\u5f20\u5bb6\u6bd3 \u7279\u4f18\u5956\uff1a\u8a31\u7dad\u6f22\u3001\u6797\u7fca\u6069\u3001\u9ece\u5038\u5229\u3001\u4f55\u6d0b\u9707\u3001\u6d2a\u5609\u742a\nB. \u8001\u5e08 /\u5b66\u827a\u73ed/\u4f1a\u5458\u7ec4 \u51a0\u519b\uff1a\u5468\u7389\u94bb \u4e9a\u519b\uff1a\u5eb7\u6dd1\u5a77 \u5b63\u519b\uff1a\u53f6\u5a49\u745c \u7279\u4f18\u5956\uff1a\u90d1\u6167\u59ae\u3001\u4f59\u79c0\u84c9\u3001\u9ec4\u5999\u82f1\u3001\u8c22\u5609\u6b23\u3001\u53f6\u83f2\u7434\nC. \u4e2d\u5b66\u9ad8\u4e2d\u7ec4 \u51a0\u519b\uff1a\u90d1\u9756\u6167 \u4e9a\u519b\uff1a\u738b\u9547\u94ed \u5b63\u519b\uff1a\u90d1\u9756\u9716 \u7279\u4f18\u5956\uff1a \u90c9\u97f6\u54f2\u3001\u9648\u4e3d\u9896\nD. \u4e2d\u5b66\u521d\u4e2d\u7ec4 \u51a0\u519b\uff1a\u9ec4\u82b7\u82af \u4e9a\u519b\uff1a \u5f6d\u82b7\u6674 \u5b63\u519b\uff1a\u6c6a\u653f\u5146 \u7279\u4f18\u5956\uff1a \u6234\u6069\u82af\u3001\u5f20\u6653\u60e0\u3001\u82cf\u51a0\u5b87\u3001\u9648\u4e3d\u61ac\u3001\u6881\u82b8\u8367\nE. \u5c0f\u5b66\u9ad8\u5e74\u7ea7\u7ec4 \u51a0\u519b\uff1a\u6234\u6069\u82e1 \u4e9a\u519b\uff1a\u9ec4\u6893\u606c \u5b63\u519b\uff1a\u4f55\u5bb6\u9f50 \u7279\u4f18\u5956\uff1a\u5434\u828a\u6167\u3001\u66fe\u6690\u68cb\u3001\u9648\u5927\u6069\u3001\u859b\u4e54\u6069\u3001\u5f20\u94a7\u6db5 \u4f18\u79c0\u5956\uff1a\u9ece\u51ef\u6587\u3001\u6881\u664f\u6d01\u3001\u9648\u8c26\u7448\u3001\u9127\u5349\u752f\u3001\u989c\u777f\u6069\u3001\u5218\u82b7\u745c\u3001\u90d1\u77e5\u6615\u3001\u6797\u5029\u5982\u3001\u7f57\u73c8\u851a\u3001\u9648\u4e3d\u9890\u3001\u67ef\u9701\u8f69\u3001\u8521\u9889\u535a\u3001\u6797\u478d\u6069\u3001\u9ec4\u51ef\u9713\u3001\u674e\u6b23\u73a5\u3001\u674e\u4e50\u6069\u3001\u5218\u5a55\u745c\u3001\u674e\u6615\u83b9\u3001\u674e\u6b23\u8bed\u3001\u9ec4\u661f\u8bed\nF. \u5c0f\u5b66\u4f4e\u5e74\u7ea7\u7ec4 \u51a0\u519b\uff1a\u9648\u660a\u8f69 \u4e9a\u519b\uff1a\u9ec4\u6b46\u598d \u5b63\u519b\uff1a\u9ec4\u5b50\u664b \u7279\u4f18\u5956\uff1a\u5f35\u9756\u598d\u3001\u953a\u5fc3\u67d4\u3001\u674e\u5e78\u6021\u3001\u8fde\u9756\u73ca\u3001\u9648\u6f8d\u82af \u4f18\u79c0\u5956\uff1a\u6797\u548f\u4e50\u3001\u9648\u7a37\u6613\u3001\u6d2a\u6d61\u8f69\u3001\u4f55\u5b9b\u5b9c\u3001\u5468\u6615\u9896\u3001\u5f90\u5a67\u8bed\u3001\u6797\u4e66\u6210\u3001\u90b1\u6d48\u5584\u3001\u5f20\u94a7\u752f\u3001\u9ec4\u4ee5\u99a8\u3001\u4f55\u5bb6\u6cbb\u3001\u9648\u6770\u839b\u3001\u674e\u4e50\u6052\u3001\u4f59\u79f2\u7a4e\u3001\u82cf\u6620\u970f\u3001\u5f90\u5349\u83c1\u3001\u9648\u6653\u6148\u3001\u5218\u5b50\u6069\u3001\u9648\u884d\u6615\u3001\u6797\u5f66\u6021"}