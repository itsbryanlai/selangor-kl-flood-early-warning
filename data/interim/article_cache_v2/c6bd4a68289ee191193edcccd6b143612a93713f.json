{"url": "https://www.enanyang.my/%E8%A6%81%E9%97%BB/%E3%80%90%E7%8B%AC%E5%AE%B6%E3%80%91%E9%85%92%E5%BA%97%E7%A6%81%E9%85%92%C2%B7%E5%92%A8%E8%AF%A2%E9%87%8F%E5%A2%9E-%E4%B8%B9%E6%B0%91%E6%88%96%E7%A5%9E%E5%BA%99%E7%A4%BC%E5%A0%82%E5%8A%9E%E5%A9%9A%E5%AE%B4", "meta_date": "2024-12-15", "title": "\u3010\u72ec\u5bb6\u3011\u9152\u5e97\u7981\u9152\u00b7\u54a8\u8be2\u91cf\u589e \u4e39\u6c11\u6216\u795e\u5e99\u793c\u5802\u529e\u5a5a\u5bb4 | e\u5357\u6d0b", "text": "\u3010\u72ec\u5bb6\u3011\u9152\u5e97\u7981\u9152\u00b7\u54a8\u8be2\u91cf\u589e \u4e39\u6c11\u6216\u795e\u5e99\u793c\u5802\u529e\u5a5a\u5bb4 | e\u5357\u6d0b\n\uff08\u54e5\u6253\u5cc7\u9c8115\u65e5\u8baf\uff09\u968f\u7740 \u5409\u5170\u4e39 \u9152\u5e97 \u7981\u9152 \u4e8b\u4ef6\u6301\u7eed\u53d1\u9175\u540e\uff0c\u8bb8\u591a\u6709\u610f\u4e3e\u529e \u5a5a\u5bb4 \u6216\u5176\u4ed6\u6d3b\u52a8\u7684\u534e\u88d4\u4e5f\u9009\u62e9\u6539\u54a8\u8be2\u5f53\u5730 \u795e\u5e99 \u7684\u793c\u5802\uff0c\u5176\u4e2d\u5173\u5fc3\u7684\u6838\u5fc3\u8bae\u9898\u5c31\u662f\u201c\u80fd\u5426\u559d\u9152\uff1f\u201d\n\u5f53\u5730 \u795e\u5e99 \u793c\u5802\u8d1f\u8d23\u4eba\u544a\u8bc9\u300a\u5357\u6d0b\u5546\u62a5\u300b\uff0c\u8fd1\u671f\u5927\u90e8\u5206\u7684\u54a8\u8be2\u7535\u8bdd\uff0c\u96be\u514d\u4f1a\u8c08\u5230\u559d\u9152\u7684\u4e8b\u5b9c\u3002\n\u968f\u7740\u8fd9\u90e8\u5206\u5ba2\u6237\u4ece \u9152\u5e97 \u5916\u79fb\uff0c\u5f53\u5730\u98df\u8086\u4e1a\u8005\u76f8\u4fe1\u4e5f\u5c06\u5e26\u52a8\u751f\u610f\uff0c\u7136\u800c\u76f8\u4fe1\u7ed9 \u9152\u5e97 \u9020\u6210\u7684\u51b2\u51fb\u6216\u6ca1\u6709\u60f3\u50cf\u4e2d\u5927\uff0c\u8fd8\u662f\u4f1a\u6709\u5bb6\u5ead\u8003\u8651\u5230\u4fbf\u5229\u56e0\u7d20\u800c\u9009\u62e9 \u9152\u5e97 \u6446\u8bbe\u5bb4\u5e2d\u3002\n\u54e5\u6253\u5cc7\u9c81\u5510\u4eba\u5761\u5988\u59d0\u5e99\u7684\u793c\u5802\u7684\u79df\u7528\u54a8\u8be2\u4e5f\u7565\u589e\u52a0\uff0c\u5927\u90e8\u5206\u54a8\u8be2\u8005\u5173\u5fc3\u662f\u5426\u53ef\u5728\u79df\u501f\u671f\u95f4\u996e\u9152\u3002\n\u5409\u5170\u4e39 \u9547\u5174\u5bab\u4e3b\u5e2d\u989c\u6c38\u9686\u6307\u51fa\uff0c\u8fd1\u65e5\u6709\u63a5\u5230\u4e0d\u5c11\u4eba\u8be2\u95ee\u8be5\u5bab\u793c\u5802\u7684\u95ee\u9898\uff0c\u540c\u65f6\u8fd8\u8be2\u95ee\u5927\u5bb6\u8fd1\u671f\u6240\u5173\u5fc3\u7684\u95ee\u9898\u3002\n\u201c\u6211\u4eec\u6709\u5411\u5e02\u8bae\u5458\u8be2\u95ee\u6709\u5173\u672c\u5bab\u793c\u5802\u7684\u95ee\u9898\uff0c\u5e76\u5df2\u786e\u8ba4\u672c\u5bab\u7684\u793c\u5802\u662f\u80fd\u591f\u63a5\u53d7\u975e\u6e05\u771f\u996e\u54c1\uff08\u5305\u62ec\u9152\u7c7b\uff09\uff0c\u6240\u4ee5\u987e\u5ba2\u90fd\u4e0d\u7528\u62c5\u5fc3\u53d7\u5230\u5f71\u54cd\u3002\u201d\n\u5409\u5170\u4e39 \u5dde\u5185\u975e\u6e05\u771f\u98df\u8086\u4e1a\u8005\u8ba4\u4e3a\uff0c \u9152\u5e97 \u7981\u9152 \u4e8b\u4ef6\uff0c\u6216\u591a\u6216\u5c11\u90fd\u4f1a\u5e26\u52a8\u4ed6\u4eec\u7684\u751f\u610f\uff0c\u4f46\u5b9e\u9645\u4e0a\u5e76\u4e0d\u4f1a\u5e26\u6765\u592a\u591a\u751f\u610f\u3002\n\u4e0d\u613f\u5177\u540d\u7684\u9152\u697c\u4e1a\u8005\u53d7\u8be2\u65f6\u8bf4\uff0c\u5927\u90e8\u5206\u987e\u5ba2\u9009\u62e9\u5728 \u9152\u5e97 \u4e3e\u884c \u5a5a\u5bb4 \uff0c\u6700\u5927\u56e0\u7d20\u662f\u65b9\u4fbf\uff0c\u53ef\u4e00\u6761\u9f99\u89e3\u51b3\u6240\u6709\u95ee\u9898\uff0c\u65e0\u9700\u70e6\u607c\u79df\u7528\u573a\u5730\u3001\u97f3\u54cd\u53ca\u8ba2\u8d2d\u83dc\u80b4\uff0c\u56e0\u6b64\u662f\u5426\u53ef\u996e\u9152\u4e0d\u518d\u662f\u6700\u5173\u952e\u7684\u95ee\u9898\u3002\n\u82e5\u5bb6\u5c5e\u8fd8\u662f\u89c9\u5f97\u5bb4\u4f1a\u4e0a\u5fc5\u987b\u6709\u9152\uff0c\u53ef\u50cf\u8fc7\u53bb\u822c\u9009\u62e9\u5728 \u5409\u5170\u4e39 \u4e2d\u534e\u603b\u5546\u4f1a\u6216 \u5409\u5170\u4e39 \u9547\u5174\u5bab\u7b49\u5730\u4e3e\u529e\u5bb4\u5e2d\u3002\n\u201c\u6211\u8ba4\u4e3a\uff0c \u9152\u5e97 \u7981\u9152 \u540e\uff0c\u8fd8\u662f\u4f1a\u6709\u534e\u793e\u6216\u534e\u4eba\u9009\u62e9\u5728 \u9152\u5e97 \u529e\u5bb4\u4f1a\u53ca\u5a5a\u793c\u3002\u5bb4\u5e2d\u6ca1\u63d0\u4f9b\u9152\u7c7b\uff0c\u53cd\u800c\u53ef\u8ba9\u4e3b\u4eba\u5bb6\u7701\u4e0b\u4e00\u7b14\uff0c\u66f4\u4f55\u51b5\u5927\u90e8\u5206\u9009\u62e9\u5728 \u9152\u5e97 \u529e\u5bb4\u4f1a\u7684\uff0c\u90fd\u662f\u4e3a\u4e86\u65b9\u4fbf\u3002\u201d\n\u81f3\u4e8e\u4e34\u8fd1\u519c\u5386\u65b0\u5e74\u524d\u5915\u7684\u5c3e\u7259\uff0c\u4e1a\u8005\u5219\u6307\u4f1a\u6709\u66f4\u591a\u516c\u53f8\u9009\u62e9\u975e\u6e05\u771f\u98df\u8086\uff0c\u5bf9\u534e\u4eba\u516c\u53f8\u800c\u8a00\uff0c\u5c3e\u7259\u662f\u5e86\u795d\u8fc7\u53bb\u4e00\u5e74\u7684\u6210\u7ee9\uff0c\u56e0\u6b64\u4f1a\u9009\u62e9\u53ef\u4ee5\u996e\u9152\u7684\u98df\u8086\uff0c\u6240\u4ee5\u4eca\u5e74\u7684\u5c3e\u7259\u8ba2\u5355\u7565\u6709\u589e\u52a0\u3002\n\u9152\u697c\u4e1a\u8005\u4e5f\u8ba4\u4e3a\uff0c\u4e39\u5dde\u653f\u5e9c\u4e0d\u5e94\u8be5\u9650\u5236\u975e\u56de\u6559\u5f92\u996e\u9152\uff0c\u6bd5\u7adf\u987e\u5ba2\u6ca1\u6709\u4f7f\u7528 \u9152\u5e97 \u7684\u73bb\u7483\u676f\u996e\u9152\uff0c\u4e00\u822c\u90fd\u662f\u8bf7\u5564\u9152\u5546\u4ee3\u529e\u3002\n\u4ed6\u8bf4\uff0c\u5e74\u672b\u90fd\u4f1a\u6709\u4e0d\u5c11\u5546\u5bb6\u4e3e\u529e\u5c3e\u7259\u6216\u65b0\u5e74\u805a\u9910\uff0c\u8fd9\u4e9b\u805a\u9910\u90fd\u8981\u996e\u9152\u3002\u56e0\u6b64 \u9152\u5e97 \u7981\u9152 \u4e8b\u4ef6\u53d1\u9175\u5e76\u4e0d\u610f\u5916\uff0c\u987e\u5ba2\u4f1a\u8003\u8651\u5230\u9152\u697c\u4e3e\u529e\u6d3b\u52a8\u3002\n\u5409\u5170\u4e39 \u591a\u5bb6 \u9152\u5e97 \u56e0\u8fdd\u53cd \u7981\u9152 \u653f\u7b56\u5bfc\u81f4\u5176\u6e05\u771f\u8ba4\u8bc1\u88ab\u51bb\u7ed3\uff0c\u90e8\u5206 \u9152\u5e97 \u7684 \u5a5a\u5bb4 \u3001\u516c\u53f8\u5e74\u5bb4\u7b49\u8ba2\u5355\u5728\u77ed\u671f\u5185\u6709\u9ad8\u8fbe\u516b\u6210\u88ab\u53d6\u6d88\u3002\n\u636e\u4e86\u89e3\uff0c\u672c\u5730 \u9152\u5e97 \u4e1a\u8005\u5411\u6765\u4e0d\u4f9b\u5e94\u9152\u6c34\uff0c\u90fd\u662f\u5bbe\u5ba2\u81ea\u884c\u5e26\u9152\u8d74\u5bb4\uff0c\u6216\u5411\u5564\u9152\u5546\u201c\u79df\u9152\u676f\u201d\uff0c\u4e00\u4e2a\u9152\u676f\u201c\u79df\u201d2\u4ee4\u5409\uff0c\u987e\u5ba2\u4e5f\u4e0d\u4f1a\u4f7f\u7528 \u9152\u5e97 \u7684\u5668\u5177\u76db\u9152\u3002\n\u53e6\u4e00\u65b9\u9762, \u5409\u5170\u4e39 \u4e2d\u534e\u603b\u5546\u4f1a\u5c06\u4e8e\u660e\u65e5\u9488\u5bf9 \u9152\u5e97 \u7981\u9152 \u8bfe\u9898\u4f1a\u89c1\u53d7\u5f71\u54cd\u76843\u5bb6 \u9152\u5e97 \u4e1a\u8005\uff0c\u4e4b\u540e\u5c06\u53ec\u5f00\u7531\u4e39\u4e2d\u603b\u4f1a\u957f\u62ff\u7763\u53f6\u7fc3\u745a\u4e3b\u6301\u7684\u201c\u534e\u4eba\u5bb4\u4f1a\u5728\u5404\u5927 \u9152\u5e97 \u4e0d\u5f97\u5bb4\u8bf7\u9152\u7c7b\u201d\u8bfe\u9898\u7684\u65b0\u95fb\u53d1\u5e03\u4f1a\u3002\n\u8f83\u65e9\u524d\uff0c\u6c11\u4e3b\u884c\u52a8\u515a\u4e39\u5dde\u4e3b\u5e2d\u6f58\u8fd0\u8d22\u63ed\u9732\uff0c\u54e5\u6253\u5cc7\u9c81\u5e02\u8bae\u4f1a\u8054\u5408 \u5409\u5170\u4e39 \u5dde\u5b97\u6559\u4e8b\u52a1\u5c40\u5728\u5dde\u5185 \u9152\u5e97 \u7981\u9152 \uff0c\u5305\u62ec\u534e\u88d4\u4e3e\u529e\u7684\u5bb4\u4f1a\u90fd\u4e0d\u80fd\u6709\u9152\uff0c\u5f15\u8d77\u8bae\u8bba\u3002\n\u53e6\u4e00\u65b9\u9762\uff0c\u53d7 \u7981\u9152 \u4ee4\u5f71\u54cd\u7684\u54e5\u5e02\u4e07\u4e3d \u9152\u5e97 \u5df2\u91cd\u65b0\u7533\u8bf7\u6e05\u771f\u8ba4\u8bc1\uff0c\u76ee\u524d\u76f8\u5173\u7a0b\u5e8f\u6b63\u5728\u8fdb\u884c\u4e2d\u3002\n\u8be5 \u9152\u5e97 \u5728\u5b98\u65b9\u8138\u4e66\u4e0a\u53d1\u5e03\u58f0\u660e\uff0c\u9488\u5bf9\u793e\u4ea4\u5a92\u4f53\u4e0a\u5173\u4e8e\u5176\u6e05\u771f\u8bc1\u4e66\u88ab\u64a4\u9500\u7684\u8ba8\u8bba\uff0c\u8868\u793a\u6df1\u523b\u7406\u89e3\u6e05\u771f\u8ba4\u8bc1\u5bf9\u793e\u4f1a\uff0c\u5c24\u5176\u662f\u5bf9\u4ed6\u4eec\u5ba2\u4eba\u7684\u91cd\u8981\u6027\u3002\n\u201c\u56e0\u6b64\uff0c\u6211\u4eec\u5728\u6b64\u901a\u77e5\uff0c\u5df2\u4e8e12\u67084\u65e5\u63d0\u4ea4\u65b0\u7684\u6e05\u771f\u8ba4\u8bc1\u7533\u8bf7\uff0c\u5e76\u6b63\u5728\u4e0e\u76f8\u5173\u90e8\u95e8\u5bc6\u5207\u5408\u4f5c\uff0c\u529b\u6c42\u5c3d\u5feb\u5b8c\u6210\u7533\u8bf7\u6d41\u7a0b\u3002\u201d\n\u9152\u5e97 \u5f3a\u8c03\uff0c\u98df\u54c1\u7684\u51c6\u5907\u5de5\u4f5c\u7531 \u9152\u5e97 \u884c\u653f\u603b\u53a8\u4e25\u683c\u76d1\u7ba1\u3002\u9488\u5bf9\u4e2a\u522b\u4eba\u58eb\u6307\u8d23\u5176\u98df\u54c1\u975e\u6e05\u771f\u4e00\u4e8b\uff0c \u9152\u5e97 \u575a\u51b3\u5426\u8ba4\uff0c\u79f0\u6b64\u8bf4\u6cd5\u5b8c\u5168\u4e0d\u5b9e\u3002\n\u201c\u6211\u4eec\u7684\u98df\u7269\u51c6\u5907\u5b8c\u5168\u9075\u5faa\u6e05\u771f\u6807\u51c6\u64cd\u4f5c\u7a0b\u5e8f\uff0c\u7279\u522b\u662f\u4e3a\u56de\u6559\u5f92\u5ba2\u4eba\u51c6\u5907\u7684\u9910\u98df\u3002\u81f3\u4e8e\u6709\u5173\u8fdd\u7981\u54c1\u7684\u6307\u63a7\uff0c\u662f\u672a\u7ecf \u9152\u5e97 \u68c0\u67e5\uff0c\u7531\u4e0d\u8d1f\u8d23\u4efb\u7684\u4eba\u58eb\u79c1\u81ea\u5e26\u5165 \u9152\u5e97 \u4f9b\u975e\u56de\u6559\u5f92\u4f7f\u7528\u3002\u201d\n\u8be5 \u9152\u5e97 \u8868\u793a\u5df2\u5efa\u7acb\u4e25\u683c\u7684\u64cd\u4f5c\u6807\u51c6\uff0c\u5e76\u52a0\u5f3a\u76d1\u63a7\u63aa\u65bd\uff0c\u786e\u4fdd\u6e05\u771f\u53a8\u623f\u5b8c\u5168\u7b26\u5408\u56de\u6559\u6cd5\u7684\u8981\u6c42\u3002"}